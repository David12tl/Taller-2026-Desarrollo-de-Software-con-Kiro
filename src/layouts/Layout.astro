---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Taller de Kiro & SDD | Desarrollo de Software con IA y Especificaciones" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
