---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kiro IDE & SDD | Desarrollo de Software Inteligente con AWS">
	<main>
		<!-- SECCIÓN 1: HERO (100vh) -->
		<section id="hero">
			<!-- Fondo de imagen con overlay oscuro -->
			<div 
				class="section-bg-image" 
				style="background-image: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="section-overlay"></div>

			<div class="section-content">
				<div class="kiro-badge">
					<span class="kiro-badge-dot"></span>
					AWS Bedrock & Spec-Driven Development
				</div>
				
				<!-- Título principal con Icono 3D de Robot/Fantasma flotante al lado -->
				<div class="hero-title-row">
					<h1 id="hero-title" class="hero-title">Kiro <span>& SDD</span></h1>
					<img 
						src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Robot/3D/robot_3d.png" 
						alt="Kiro AI 3D Robot" 
						class="icon-3d hero-icon-3d" 
					/>
				</div>

				<p id="hero-subtitle" class="hero-subtitle">
					La IDE impulsada por IA que transforma especificaciones rigurosas en código determinista de producción.
				</p>
			</div>

			<div class="hero-scroll-indicator">
				<div class="mouse-icon">
					<div class="mouse-wheel"></div>
				</div>
				<span>Desplaza para explorar</span>
			</div>
		</section>

		<!-- SECCIÓN 2: SCROLL ZOOM (100vh) -->
		<section id="scroll-zoom">
			<div 
				class="section-bg-image" 
				style="background-image: url('https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="section-overlay"></div>

			<div class="section-content">
				<div class="zoom-card glass-container">
					<!-- Icono 3D de alerta / documento roto flotando sutilmente -->
					<img 
						src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Warning/3D/warning_3d.png" 
						alt="Alerta 3D Kiro" 
						class="icon-3d zoom-icon-3d" 
					/>
					<span class="zoom-label">La Deuda Técnica de la IA sin Guía</span>
					<h2 class="zoom-title">El problema real</h2>
					<p class="zoom-description">
						El código autogenerado sin especificaciones formales genera caos, alucinaciones arquitectónicas y miles de horas de depuración. Kiro soluciona la raíz: estructuración previa antes de la ejecución.
					</p>
				</div>
			</div>
		</section>

		<!-- SECCIÓN 3: HORIZONTAL CONTAINER (300vh de scroll) -->
		<section id="horizontal-container">
			<div id="horizontal-track">
				<!-- Panel 1: Settings / Engranaje 3D -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-glass-card glass-container">
						<div class="panel-header-row">
							<span class="panel-number">01</span>
							<span class="panel-tag">Configuración & Settings</span>
						</div>
						<div class="panel-body-content">
							<div class="panel-text-block">
								<h3>Alineación de Entorno (Settings)</h3>
								<p>
									Configura el runtime, define variables de observabilidad y establece las fronteras de ejecución para los agentes Kiro en tu stack de AWS.
								</p>
							</div>
							<div class="panel-icon-wrap">
								<img 
									src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Gear/3D/gear_3d.png" 
									alt="Engranaje 3D Settings" 
									class="icon-3d" 
								/>
							</div>
						</div>
						<div class="panel-footer-pills">
							<span class="panel-pill">#EnvironmentConfig</span>
							<span class="panel-pill">#AWSBedrock</span>
							<span class="panel-pill">#RuntimeControl</span>
						</div>
					</div>
				</div>

				<!-- Panel 2: Spec / Documento 3D -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-glass-card glass-container">
						<div class="panel-header-row">
							<span class="panel-number">02</span>
							<span class="panel-tag">Especificaciones (Spec)</span>
						</div>
						<div class="panel-body-content">
							<div class="panel-text-block">
								<h3>Spec-Driven Development</h3>
								<p>
									Documentos vivos y contratos ejecutables que guían cada paso del desarrollo. Ningún código se crea sin validación previa contra la especificación.
								</p>
							</div>
							<div class="panel-icon-wrap">
								<img 
									src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Page%20facing%20up/3D/page_facing_up_3d.png" 
									alt="Documento 3D Spec" 
									class="icon-3d" 
								/>
							</div>
						</div>
						<div class="panel-footer-pills">
							<span class="panel-pill">#FormalSpecs</span>
							<span class="panel-pill">#NoHallucinations</span>
							<span class="panel-pill">#ArchitectureFirst</span>
						</div>
					</div>
				</div>

				<!-- Panel 3: Tasks / Código & Laptop 3D -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-glass-card glass-container">
						<div class="panel-header-row">
							<span class="panel-number">03</span>
							<span class="panel-tag">Ejecución & Tasks</span>
						</div>
						<div class="panel-body-content">
							<div class="panel-text-block">
								<h3>Tareas Autónomas Verificadas</h3>
								<p>
									Kiro divide la implementación en tareas atómicas verificables con compilación y tests automatizados antes de consolidar el commit.
								</p>
							</div>
							<div class="panel-icon-wrap">
								<img 
									src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Laptop/3D/laptop_3d.png" 
									alt="Código y Laptop 3D" 
									class="icon-3d" 
								/>
							</div>
						</div>
						<div class="panel-footer-pills">
							<span class="panel-pill">#AutonomousTasks</span>
							<span class="panel-pill">#ZeroDefects</span>
							<span class="panel-pill">#DeterministicOutput</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECCIÓN 4: TEXT EFFECTS (100vh) -->
		<section id="text-effects">
			<div class="section-content">
				<div class="text-effects-header">
					<h2>Efectos Tipográficos & Core de Kiro</h2>
				</div>

				<div class="text-effects-grid">
					<!-- EFECTO 1: Scramble Text con color kiro-purple-light -->
					<div class="effect-glass-card glass-container">
						<span class="effect-label">Efecto 1 • Scramble Decode Kiro</span>
						<div id="scramble-text" data-text="KIRO PROTOCOL: SPECIFICATION VERIFIED">
							KIRO PROTOCOL: SPECIFICATION VERIFIED
						</div>
					</div>

					<!-- EFECTO 2: Per Character con SplitType -->
					<div class="effect-glass-card glass-container">
						<span class="effect-label">Efecto 2 • Caracteres con Split-Type</span>
						<div id="split-text">
							Arquitectura Determinista con AWS Bedrock
						</div>
					</div>

					<!-- EFECTO 3: Text Loop infinito alternando Specs, Hooks, Steering -->
					<div class="effect-glass-card glass-container">
						<span class="effect-label">Efecto 3 • Loop Infinito de Conceptos Kiro</span>
						<div class="loop-wrapper">
							<span class="loop-prefix">Ecosistema Kiro:</span>
							<span id="loop-text">Specs</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECCIÓN 5: PARALLAX (100vh) -->
		<section id="parallax">
			<!-- Fondo de imagen con height 120% y top -10% para evitar bordes al aplicar yPercent: 20 -->
			<div 
				id="parallax-bg" 
				style="background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="parallax-overlay"></div>

			<div class="parallax-card glass-container">
				<!-- Icono 3D grande de Nube / Cloud flotando -->
				<img 
					src="https://raw.githubusercontent.com/microsoft/fluentui-emoji/main/assets/Cloud/3D/cloud_3d.png" 
					alt="AWS Cloud 3D" 
					class="icon-3d parallax-icon-3d" 
				/>
				<div class="kiro-badge">
					<span class="kiro-badge-dot"></span>
					Potencia Cloud con AWS & Kiro
				</div>
				<h2 class="parallax-title">Lleva tu ingeniería al siguiente nivel</h2>
				<p class="parallax-desc">
					Aprende a estructurar software de alta complejidad con Kiro, combinando el poder del Spec-Driven Development y la nube de AWS.
				</p>
				<a href="#hero" class="cta-button">
					<span>Comenzar Ahora con Kiro</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import SplitType from 'split-type';

	// Registro de ScrollTrigger
	gsap.registerPlugin(ScrollTrigger);

	const initAnimations = () => {
		// Limpieza de triggers existentes para evitar duplicaciones
		ScrollTrigger.getAll().forEach(t => t.kill());

		/* ==========================================================================
		   A. ANIMACIÓN DE FLOTACIÓN (3D Icons)
		   - Levitación infinita en todos los .icon-3d
		   ========================================================================== */
		gsap.to('.icon-3d', {
			y: -20,
			rotation: 2,
			duration: 2,
			repeat: -1,
			yoyo: true,
			ease: 'power1.inOut',
			stagger: 0.2
		});

		/* ==========================================================================
		   B. SCROLL ZOOM HERO (Sección 1)
		   - ScrollTrigger en #hero con pin: true y scrub: true
		   - El título y el icono 3D escalan y se desvanecen (scale: 2, opacity: 0)
		   ========================================================================== */
		gsap.to(['#hero-title', '.hero-icon-3d'], {
			scale: 2,
			opacity: 0,
			ease: 'none',
			scrollTrigger: {
				trigger: '#hero',
				start: 'top top',
				end: '+=100%',
				pin: true,
				scrub: true,
			}
		});

		// Desvanecer subtítulo y badge en el scroll
		gsap.to(['#hero-subtitle', '.kiro-badge', '.hero-scroll-indicator'], {
			opacity: 0,
			y: -25,
			ease: 'none',
			scrollTrigger: {
				trigger: '#hero',
				start: 'top top',
				end: '+=50%',
				scrub: true,
			}
		});

		/* ==========================================================================
		   C. SCROLL HORIZONTAL (Sección 3)
		   - ScrollTrigger para #horizontal-container con pin: true y scrub: true
		   - Anima #horizontal-track en el eje X (xPercent: -66.66)
		   - end: "+=300%"
		   ========================================================================== */
		gsap.to('#horizontal-track', {
			xPercent: -66.66,
			ease: 'none',
			scrollTrigger: {
				trigger: '#horizontal-container',
				start: 'top top',
				end: '+=300%',
				pin: true,
				scrub: true,
				anticipatePin: 1,
			}
		});

		/* ==========================================================================
		   D. PARALLAX (Sección 5)
		   - Anima #parallax-bg con yPercent: 20 y scrub: true
		   - Altura 120% y top: -10% configurados en CSS
		   ========================================================================== */
		gsap.to('#parallax-bg', {
			yPercent: 20,
			ease: 'none',
			scrollTrigger: {
				trigger: '#parallax',
				start: 'top bottom',
				end: 'bottom top',
				scrub: true,
			}
		});

		/* ==========================================================================
		   E. TEXT EFFECTS (Sección 4)
		   ========================================================================== */

		// EFECTO 1: Scramble Text (Función JS custom que cambia letras por 1 seg)
		const scrambleEl = document.getElementById('scramble-text');
		if (scrambleEl) {
			const targetString = scrambleEl.getAttribute('data-text') || scrambleEl.textContent || '';
			const glyphs = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789_#@&%*+=-/<>[]';

			const runScramble = (el: HTMLElement, originalText: string, duration = 1000) => {
				const startTime = performance.now();
				const len = originalText.length;

				const tick = (now: number) => {
					const elapsed = now - startTime;
					const progress = Math.min(elapsed / duration, 1);
					const revealed = Math.floor(progress * len);

					let output = '';
					for (let i = 0; i < len; i++) {
						if (i < revealed) {
							output += originalText[i];
						} else if (originalText[i] === ' ') {
							output += ' ';
						} else {
							output += glyphs[Math.floor(Math.random() * glyphs.length)];
						}
					}

					el.textContent = output;

					if (progress < 1) {
						requestAnimationFrame(tick);
					} else {
						el.textContent = originalText;
					}
				};

				requestAnimationFrame(tick);
			};

			ScrollTrigger.create({
				trigger: scrambleEl,
				start: 'top 85%',
				onEnter: () => runScramble(scrambleEl, targetString, 1000),
				onEnterBack: () => runScramble(scrambleEl, targetString, 1000),
			});
		}

		// EFECTO 2: Per Character con SplitType
		const splitEl = document.getElementById('split-text');
		if (splitEl) {
			const split = new SplitType('#split-text', { types: 'chars' });
			if (split.chars && split.chars.length > 0) {
				gsap.fromTo(
					split.chars,
					{ y: 50, opacity: 0 },
					{
						y: 0,
						opacity: 1,
						stagger: 0.05,
						duration: 0.8,
						ease: 'power3.out',
						scrollTrigger: {
							trigger: '#split-text',
							start: 'top 85%',
							toggleActions: 'play none none reverse',
						}
					}
				);
			}
		}

		// EFECTO 3: Text Loop (Animación infinita repeat: -1 que cambie entre "Specs", "Hooks", "Steering")
		const loopEl = document.getElementById('loop-text');
		if (loopEl) {
			const words = ['Specs', 'Hooks', 'Steering'];
			const loopTimeline = gsap.timeline({ repeat: -1 });

			words.forEach((word) => {
				loopTimeline
					.to(loopEl, {
						opacity: 0,
						y: -15,
						scale: 0.9,
						duration: 0.35,
						ease: 'power2.in',
						onComplete: () => {
							loopEl.textContent = word;
						}
					})
					.to(loopEl, {
						opacity: 1,
						y: 0,
						scale: 1,
						duration: 0.45,
						ease: 'power2.out',
					})
					.to({}, { duration: 1.2 }); // Mantener visible cada palabra por 1.2s
			});
		}

		// Recalcular ScrollTrigger
		ScrollTrigger.refresh();
	};

	// Ejecución segura en ciclo de vida del DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAnimations);
	} else {
		initAnimations();
	}

	window.addEventListener('load', () => {
		ScrollTrigger.refresh();
	});
</script>
