---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Taller Kiro & SDD | Desarrollo de Software Guiado por Especificaciones">
	<main>
		<!-- SECCIÓN 1: HERO (100vh) -->
		<section id="hero">
			<!-- Fondo de imagen real con overlay oscuro al 60% -->
			<div 
				class="section-bg-image" 
				style="background-image: url('https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="section-overlay"></div>

			<div class="section-content">
				<div class="pill-badge">
					<span class="pill-dot"></span>
					Taller Kiro 2026 • Spec-Driven Development
				</div>
				<h1 id="hero-title" class="hero-title">Kiro & SDD</h1>
				<p id="hero-subtitle" class="hero-subtitle">
					Ingeniería de software de alta fidelidad basada en especificaciones formales y desarrollo autónomo supervisado.
				</p>
			</div>

			<div class="hero-scroll-indicator">
				<div class="mouse-icon">
					<div class="mouse-wheel"></div>
				</div>
				<span>Desplaza para explorar</span>
			</div>
		</section>

		<!-- SECCIÓN 2: SCROLL ZOOM (100vh) -->
		<section id="scroll-zoom">
			<div 
				class="section-bg-image" 
				style="background-image: url('https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="section-overlay"></div>

			<div class="section-content">
				<span class="zoom-label">La Realidad del Desarrollo</span>
				<h2 class="zoom-title">El problema real</h2>
				<p class="zoom-description">
					La programación asistida por IA sin arquitectura definida genera deuda técnica instantánea. El cuello de botella de la industria ya no es escribir código, sino garantizar rigor, contexto y contratos verificables.
				</p>
			</div>
		</section>

		<!-- SECCIÓN 3: HORIZONTAL CONTAINER (300vh de scroll) -->
		<section id="horizontal-container">
			<div id="horizontal-track">
				<!-- Panel 1: Código / Especificaciones -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-card">
						<div class="panel-top">
							<span class="panel-number">01</span>
							<span class="panel-tag">Especificación</span>
						</div>
						<div class="panel-body">
							<h3>Contratos Formales (SDD)</h3>
							<p>
								Definición exhaustiva de interfaces, invariantes y escenarios de prueba antes de la implementación. Una especificación rigurosa erradica la ambigüedad en el código final.
							</p>
						</div>
						<div class="panel-footer">
							<span class="panel-pill">Modelado Formal</span>
							<span class="panel-pill">Invariantes de Estado</span>
							<span class="panel-pill">Cero Suposiciones</span>
						</div>
					</div>
				</div>

				<!-- Panel 2: Equipo / Agentes Autónomos -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-card">
						<div class="panel-top">
							<span class="panel-number">02</span>
							<span class="panel-tag">Orquestación</span>
						</div>
						<div class="panel-body">
							<h3>Agentes Especializados Kiro</h3>
							<p>
								Subagentes autónomos que investigan el repositorio en tiempo real, planifican en grafos de dependencias y ejecutan refactorizaciones respetando los límites del proyecto.
							</p>
						</div>
						<div class="panel-footer">
							<span class="panel-pill">Context Awareness</span>
							<span class="panel-pill">Subagentes Aislados</span>
							<span class="panel-pill">Pair Programming</span>
						</div>
					</div>
				</div>

				<!-- Panel 3: Oficina / Software Determinista -->
				<div class="horizontal-panel">
					<div 
						class="panel-bg" 
						style="background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1920&q=80');"
					></div>
					<div class="panel-overlay"></div>
					<div class="panel-card">
						<div class="panel-top">
							<span class="panel-number">03</span>
							<span class="panel-tag">Entrega</span>
						</div>
						<div class="panel-body">
							<h3>Software Verificable en Producción</h3>
							<p>
								Validación determinista continua mediante suites de pruebas automatizadas. Si una implementación no cumple el 100% de la especificación, los agentes corrigen antes de liberar.
							</p>
						</div>
						<div class="panel-footer">
							<span class="panel-pill">Deterministic Tests</span>
							<span class="panel-pill">CI/CD Autónomo</span>
							<span class="panel-pill">Nivel Enterprise</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECCIÓN 4: TEXT EFFECTS (100vh) -->
		<section id="text-effects">
			<div 
				class="section-bg-image" 
				style="background-image: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1920&q=80'); opacity: 0.15;"
			></div>
			<div class="section-overlay" style="background: rgba(10, 10, 10, 0.9);"></div>

			<div class="section-content">
				<div class="text-effects-header">
					<h2>Efectos Tipográficos y Protocolos</h2>
				</div>

				<div class="text-effects-grid">
					<!-- EFECTO 1: Scramble Text -->
					<div class="effect-card">
						<span class="effect-label">Efecto 1 • Scramble Decode</span>
						<div id="scramble-text" data-text="KIRO PROTOCOL: SPECIFICATION VERIFIED">
							KIRO PROTOCOL: SPECIFICATION VERIFIED
						</div>
					</div>

					<!-- EFECTO 2: Text Effect per Character con SplitType -->
					<div class="effect-card">
						<span class="effect-label">Efecto 2 • Caracteres con Split-Type</span>
						<div id="split-text">
							Arquitectura Limpia y Determinista
						</div>
					</div>

					<!-- EFECTO 3: Text Loop con timeline -->
					<div class="effect-card">
						<span class="effect-label">Efecto 3 • Loop Infinito de Variantes</span>
						<div class="loop-wrapper">
							<span class="loop-prefix">Desarrollando con</span>
							<span id="loop-text">Spec-Driven Development</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECCIÓN 5: PARALLAX (100vh) -->
		<section id="parallax">
			<!-- Fondo de imagen con height 120% y top -10% para evitar bordes al aplicar yPercent: 20 -->
			<div 
				id="parallax-bg" 
				style="background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1920&q=80');"
			></div>
			<div class="parallax-overlay"></div>

			<div class="parallax-card">
				<span class="pill-badge">Taller Práctico 2026</span>
				<h2 class="parallax-title">Aprende a liderar con Kiro & SDD</h2>
				<p class="parallax-desc">
					Domina las metodologías que separan a los desarrolladores promedio de los arquitectos que construyen sistemas de software con Inteligencia Artificial autónoma y control total.
				</p>
				<a href="#hero" class="cta-button">
					<span>Inscribirme al Taller</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import SplitType from 'split-type';

	// Registro de ScrollTrigger
	gsap.registerPlugin(ScrollTrigger);

	const initAnimations = () => {
		// Limpieza de triggers existentes para evitar duplicaciones
		ScrollTrigger.getAll().forEach(t => t.kill());

		/* ==========================================================================
		   A. SCROLL ZOOM HERO (Sección 1)
		   - ScrollTrigger en #hero con pin: true y scrub: true
		   - Título escalando (scale: 3) y desvaneciéndose (opacity: 0)
		   ========================================================================== */
		gsap.to('#hero-title', {
			scale: 3,
			opacity: 0,
			ease: 'none',
			scrollTrigger: {
				trigger: '#hero',
				start: 'top top',
				end: '+=100%',
				pin: true,
				scrub: true,
			}
		});

		// Desvanecimiento suave del subtítulo y complementos del hero
		gsap.to(['#hero-subtitle', '.pill-badge', '.hero-scroll-indicator'], {
			opacity: 0,
			y: -25,
			ease: 'none',
			scrollTrigger: {
				trigger: '#hero',
				start: 'top top',
				end: '+=50%',
				scrub: true,
			}
		});

		/* ==========================================================================
		   B. SCROLL HORIZONTAL Y TRANSICIÓN (Sección 3)
		   - ScrollTrigger para #horizontal-container con pin: true y scrub: true
		   - Anima #horizontal-track en el eje X (xPercent: -66.66) para los 3 paneles
		   - end: "+=300%"
		   - Scroll vertical restaurado automáticamente al salir
		   ========================================================================== */
		gsap.to('#horizontal-track', {
			xPercent: -66.66,
			ease: 'none',
			scrollTrigger: {
				trigger: '#horizontal-container',
				start: 'top top',
				end: '+=300%',
				pin: true,
				scrub: true,
				anticipatePin: 1,
			}
		});

		/* ==========================================================================
		   C. PARALLAX (Sección 5)
		   - Fondo #parallax-bg animado con yPercent: 20 y scrub: true
		   - La imagen tiene height: 120% y top: -10% para evitar bordes vacíos
		   ========================================================================== */
		gsap.to('#parallax-bg', {
			yPercent: 20,
			ease: 'none',
			scrollTrigger: {
				trigger: '#parallax',
				start: 'top bottom',
				end: 'bottom top',
				scrub: true,
			}
		});

		/* ==========================================================================
		   D. TEXT EFFECTS (Sección 4)
		   ========================================================================== */

		// EFECTO 1: Scramble Text (Función custom que cambia letras por 1 seg)
		const scrambleEl = document.getElementById('scramble-text');
		if (scrambleEl) {
			const targetString = scrambleEl.getAttribute('data-text') || scrambleEl.textContent || '';
			const glyphs = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789_#@&%*+=-/<>[]';

			const triggerScramble = (element: HTMLElement, original: string, duration = 1000) => {
				const startTime = performance.now();
				const len = original.length;

				const frame = (now: number) => {
					const elapsed = now - startTime;
					const progress = Math.min(elapsed / duration, 1);
					const revealedCount = Math.floor(progress * len);

					let result = '';
					for (let i = 0; i < len; i++) {
						if (i < revealedCount) {
							result += original[i];
						} else if (original[i] === ' ') {
							result += ' ';
						} else {
							result += glyphs[Math.floor(Math.random() * glyphs.length)];
						}
					}

					element.textContent = result;

					if (progress < 1) {
						requestAnimationFrame(frame);
					} else {
						element.textContent = original;
					}
				};

				requestAnimationFrame(frame);
			};

			ScrollTrigger.create({
				trigger: scrambleEl,
				start: 'top 85%',
				onEnter: () => triggerScramble(scrambleEl, targetString, 1000),
				onEnterBack: () => triggerScramble(scrambleEl, targetString, 1000),
			});
		}

		// EFECTO 2: Text Effect per Character con SplitType
		const splitEl = document.getElementById('split-text');
		if (splitEl) {
			const split = new SplitType('#split-text', { types: 'chars' });
			if (split.chars && split.chars.length > 0) {
				gsap.fromTo(
					split.chars,
					{ y: 50, opacity: 0 },
					{
						y: 0,
						opacity: 1,
						stagger: 0.05,
						duration: 0.8,
						ease: 'power3.out',
						scrollTrigger: {
							trigger: '#split-text',
							start: 'top 85%',
							toggleActions: 'play none none reverse',
						}
					}
				);
			}
		}

		// EFECTO 3: Text Loop con timeline de variantes (repeat: -1, yoyo: true)
		const loopEl = document.getElementById('loop-text');
		if (loopEl) {
			const wordVariants = [
				'Spec-Driven Development',
				'Ingeniería Determinista',
				'Agentes Autónomos Kiro',
			];

			let wordIdx = 0;
			const loopTimeline = gsap.timeline({
				repeat: -1,
				yoyo: true,
			});

			loopTimeline
				.to(loopEl, {
					scale: 1.08,
					duration: 1.1,
					ease: 'power1.inOut',
				})
				.to(loopEl, {
					opacity: 0,
					y: -12,
					duration: 0.45,
					ease: 'power2.in',
					onComplete: () => {
						wordIdx = (wordIdx + 1) % wordVariants.length;
						loopEl.textContent = wordVariants[wordIdx];
					},
					onReverseComplete: () => {
						wordIdx = (wordIdx - 1 + wordVariants.length) % wordVariants.length;
						loopEl.textContent = wordVariants[wordIdx];
					}
				})
				.to(loopEl, {
					opacity: 1,
					y: 0,
					scale: 1,
					duration: 0.55,
					ease: 'power2.out',
				})
				.to(loopEl, {
					scale: 1.05,
					duration: 1.1,
					ease: 'power1.inOut',
				});
		}

		// Recalcular ScrollTrigger
		ScrollTrigger.refresh();
	};

	// Inicialización segura en ciclo de vida del DOM
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAnimations);
	} else {
		initAnimations();
	}

	window.addEventListener('load', () => {
		ScrollTrigger.refresh();
	});
</script>
