---
import Layout from '../layouts/Layout.astro';
import ParallaxSection from '../components/ParallaxSection';
import ScrollZoomHero from '../components/ScrollZoomHero';
import WordReveal from '../components/WordReveal';

const images = {
	hero: 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=2400&q=85',
	code: 'https://images.unsplash.com/photo-1515879218367-8466d910aaa4?auto=format&fit=crop&w=2400&q=85',
	ai: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=2400&q=85',
	architecture: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=2400&q=85',
	workflow: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=2400&q=85',
	tools: 'https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=2400&q=85',
	game: 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=2400&q=85',
	servers: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=2400&q=85',
};
---

<Layout title="Arquitectura Determinista a Escala | Taller SDD">
	<main
		id="presentation-track"
		class="presentation-track"
		aria-label="Presentación del taller sobre Spec-Driven Development"
		tabindex="0"
	>
		<div class="slide" style="--slide-index: 0">
			<ScrollZoomHero
				client:visible
				title="Arquitectura Determinista a Escala"
				subtitle="El fin del Vibe Coding. Bienvenidos al Spec-Driven Development."
				imageUrl={images.hero}
				slideIndex={0}
			/>
		</div>

		<div class="slide" style="--slide-index: 1">
			<WordReveal
				client:visible
				text="El 45% del código generado por IA tiene fallas de seguridad. El Vibe Coding es genial para prototipos, pero falla al escalar. Cada sesión de chat opera de forma aislada, sin memoria. El código compila, pero está desalineado del negocio."
				imageUrl={images.code}
				slideIndex={1}
			/>
		</div>

		<div class="slide" style="--slide-index: 2">
			<ParallaxSection
				client:visible
				title="Fundamentos: De LLMs a Agentes"
				imageUrl={images.ai}
				slideIndex={2}
			>
				<p>
					Un LLM ofrece conocimiento pasivo: comprende lenguaje y responde
					preguntas, pero por sí solo no actúa en el mundo. Un agente incorpora
					herramientas para planificar y ejecutar tareas, interactuar con su
					entorno e iterar hacia un objetivo.
				</p>
			</ParallaxSection>
		</div>

		<div class="slide" style="--slide-index: 3">
			<WordReveal
				client:visible
				text="La Solución: Spec-Driven Development. La especificación es el artefacto principal. Si algo cambia, no se parchea el código; se corrige la spec y se regenera. El humano diseña el contexto, la IA acelera la ejecución."
				imageUrl={images.architecture}
				slideIndex={3}
			/>
		</div>

		<div class="slide" style="--slide-index: 4">
			<ParallaxSection
				client:visible
				title="El Flujo de Trabajo (SDD)"
				imageUrl={images.workflow}
				slideIndex={4}
			>
				<ol class="workflow-steps">
					<li>Idea: expresar la intención en lenguaje natural.</li>
					<li>Requirements (EARS): convertirla en criterios comprobables.</li>
					<li>Design: acordar arquitectura y decisiones técnicas.</li>
					<li>Tasks: desglosar el trabajo en pasos atómicos.</li>
					<li>Build: implementar y revisar el diff.</li>
					<li>Validar: ejecutar pruebas e iterar.</li>
				</ol>
			</ParallaxSection>
		</div>

		<div class="slide" style="--slide-index: 5">
			<WordReveal
				client:visible
				text="Dándole superpoderes al Agente. Tools para acciones atómicas. MCP para conectar con el mundo real sin alucinar. Skills para recetas bajo demanda. Hooks para automatizar la seguridad y el linter al guardar."
				imageUrl={images.tools}
				slideIndex={5}
			/>
		</div>

		<div class="slide" style="--slide-index: 6">
			<ParallaxSection
				client:visible
				title="Ejemplo Integrador: Flappy Ghost"
				imageUrl={images.game}
				slideIndex={6}
			>
				<p>
					Un proyecto retro que reúne física, UI/UX y persistencia de récords.
					Kiro actúa como arquitecto ejecutor: transforma la idea en requisitos,
					diseño y tareas, mientras el equipo revisa cada diff antes de aceptar
					los cambios.
				</p>
			</ParallaxSection>
		</div>

		<div class="slide" style="--slide-index: 7">
			<WordReveal
				client:visible
				text="Seguridad Cloud: nada hardcodeado; usa Secrets Manager. Aplica mínimo privilegio en IAM y jamás Action:*. El futuro no es una IA que programa sola, sino ingenieros que amplifican su criterio."
				imageUrl={images.servers}
				slideIndex={7}
				closing="Gracias por acompañarnos. Diseñemos el contexto, revisemos cada cambio y construyamos software con criterio."
			/>
		</div>
	</main>

	<div class="slide-progress" aria-hidden="true">
		<span id="scroll-progress"></span>
	</div>

	<nav class="slide-controls" aria-label="Navegación de diapositivas">
		<button id="previous-slide" type="button" aria-label="Diapositiva anterior" disabled>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
		<span id="slide-counter" class="slide-counter" aria-live="polite">01 / 08</span>
		<button id="next-slide" type="button" aria-label="Siguiente diapositiva">
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
	</nav>

	<script>
		import Lenis from 'lenis';

		const track = document.querySelector<HTMLElement>('#presentation-track');
		const previousButton = document.querySelector<HTMLButtonElement>('#previous-slide');
		const nextButton = document.querySelector<HTMLButtonElement>('#next-slide');
		const counter = document.querySelector<HTMLElement>('#slide-counter');
		const progressBar = document.querySelector<HTMLElement>('#scroll-progress');
		const slides = track
			? Array.from(track.querySelectorAll<HTMLElement>('.slide'))
			: [];
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const lenis = reducedMotion.matches
			? undefined
			: new Lenis({ autoRaf: true, lerp: 0.085, wheelMultiplier: 0.9 });

		if (track && previousButton && nextButton && counter && progressBar && slides.length) {
			const currentIndex = () =>
				Math.max(0, Math.min(slides.length - 1, Math.round(window.scrollY / window.innerHeight)));

			const updateControls = () => {
				const index = currentIndex();
				const maxScroll =
					document.documentElement.scrollHeight - window.innerHeight;
				previousButton.disabled = index === 0;
				nextButton.disabled = index === slides.length - 1;
				counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
				progressBar.style.transform = `scaleX(${maxScroll > 0 ? window.scrollY / maxScroll : 0})`;
			};

			const goToSlide = (index: number) => {
				const boundedIndex = Math.max(0, Math.min(index, slides.length - 1));
				const target = boundedIndex * window.innerHeight;

				if (lenis) {
					lenis.scrollTo(target, { duration: 1.15 });
				} else {
					window.scrollTo({ top: target, behavior: 'auto' });
				}
			};

			previousButton.addEventListener('click', () =>
				goToSlide(currentIndex() - 1),
			);
			nextButton.addEventListener('click', () =>
				goToSlide(currentIndex() + 1),
			);
			window.addEventListener('scroll', updateControls, { passive: true });
			window.addEventListener('resize', updateControls);
			window.addEventListener('keydown', (event: KeyboardEvent) => {
				if (event.altKey || event.ctrlKey || event.metaKey) return;

				if (event.key === 'ArrowDown' || event.key === 'PageDown') {
					event.preventDefault();
					goToSlide(currentIndex() + 1);
				} else if (event.key === 'ArrowUp' || event.key === 'PageUp') {
					event.preventDefault();
					goToSlide(currentIndex() - 1);
				} else if (event.key === 'Home') {
					event.preventDefault();
					goToSlide(0);
				} else if (event.key === 'End') {
					event.preventDefault();
					goToSlide(slides.length - 1);
				}
			});
			updateControls();
		}
	</script>
</Layout>
